APP_NAME=StageCue
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=stagecue
DB_USERNAME=stagecue
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STAGECUE_PAIRING_TTL_SECONDS=600
STAGECUE_COMMAND_STALE_MS=10000
STAGECUE_HEARTBEAT_MODE=whisper

# Browser-facing WebSocket endpoint (defaults to REVERB_HOST/PORT/SCHEME)
# STAGECUE_REVERB_CLIENT_HOST=
# STAGECUE_REVERB_CLIENT_PORT=
# STAGECUE_REVERB_CLIENT_SCHEME=

# Local Reverb (`php artisan reverb:start`). Laravel Cloud injects these in staging/production.
REVERB_APP_ID=stagecue-local
REVERB_APP_KEY=stagecue-local-key
REVERB_APP_SECRET=stagecue-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Rate limits (LLD §7.3 defaults). The E2E server raises them.
# STAGECUE_THROTTLE_SESSION_CREATE=10
# STAGECUE_THROTTLE_PAIRING_MINUTE=5
# STAGECUE_THROTTLE_PAIRING_HOUR=20
# STAGECUE_THROTTLE_COMMANDS=60
# STAGECUE_THROTTLE_SNAPSHOTS=120
# STAGECUE_THROTTLE_HEARTBEAT=30
