        "@types/node": "^26.6.6",
        "@types/qrcode": "^1.5.6",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vitest/coverage-v8": "^4.1.12",
        "@vue/test-utils": "^2.6.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.15.0",
        "eslint-plugin-vue": "^10.12.1",
        "fake-indexeddb": "^6.2.8",
        "fast-check": "^4.10.2",
        "globals": "^17.14.0",
        "happy-dom": "^21.0.4",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
